# Opcional: o banco é SQLite embutido e funciona com zero configuração
# (o arquivo é criado automaticamente em %APPDATA%/BuildForge/buildforge.db).
# Defina DATABASE_URL só se quiser um caminho customizado, ex:
# DATABASE_URL=file:./.data/buildforge.db
ADMIN_NAME=Nome do administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=defina_uma_senha_forte_antes_de_publicar
